# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# --- LLM provider ---
# One of: gemini | groq | anthropic | openai
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here

# --- Database ---
DATABASE_URL=postgresql://approvaliq:approvaliq@db:5432/approvaliq

# --- Vector index ---
# pgvector (default, uses the same Postgres instance) or faiss (local file index)
VECTOR_INDEX_BACKEND=pgvector

# --- Service ports ---
API_PORT=8000
FRONTEND_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO
