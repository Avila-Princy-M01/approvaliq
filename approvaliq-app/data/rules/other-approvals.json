{
  "ruleSetVersion": "2026.08.1",
  "rules": [
    {
      "id": "building-plan-area-threshold",
      "approvalId": "building-plan",
      "description": "Building and layout plan approval for commercial/industrial premises",
      "conditions": [
        {
          "field": "areaSqFt",
          "operator": "gte",
          "value": 500,
          "unit": "sq ft"
        }
      ],
      "logic": "all",
      "result": "approval-required",
      "clauseId": "dgfasli/factories-act-1948/section-6",
      "editableThreshold": {
        "conditionIndex": 0,
        "label": "Facility Area Threshold (sq ft)"
      }
    },
    {
      "id": "fire-noc-area-safety",
      "approvalId": "fire-noc",
      "description": "Fire NOC requirement for industrial or commercial premises",
      "conditions": [
        {
          "field": "areaSqFt",
          "operator": "gte",
          "value": 500,
          "unit": "sq ft"
        }
      ],
      "logic": "all",
      "result": "approval-required",
      "clauseId": "fire/maharashtra-fire-rules-2009/rule-4",
      "editableThreshold": {
        "conditionIndex": 0,
        "label": "Fire NOC Area Minimum (sq ft)"
      }
    },
    {
